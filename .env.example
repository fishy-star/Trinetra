# Copy to .env and fill in. Never commit .env.
TELEGRAM_BOT_TOKEN=
# Only needed once a webhook is registered for deployment. Telegram sends it back in a header.
TELEGRAM_WEBHOOK_SECRET=
WHATSAPP_TOKEN=
WHATSAPP_PHONE_ID=
WHATSAPP_VERIFY_TOKEN=
AWS_REGION=ap-south-1
S3_BUCKET=
BEDROCK_MODEL_ID=
LLM_MODE=off
STT_MODE=off
AUDIO_MODEL=off
# Review console at /console: comma-separated reviewer usernames, and the shared password for the 48 hours.
REVIEWERS=
REVIEWER_PASSWORD=
DATA_DIR=data/runtime
MEDIA_TTL_HOURS=24
# Secret salt for hashing chat IDs. Generate with: python3 -c "import secrets; print(secrets.token_hex(32))"
USER_ID_SALT=
# Where the public verification page /v/<code> is served; issuer QR codes link here.
PUBLIC_BASE_URL=http://localhost:8000
