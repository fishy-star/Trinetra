    {"id": "rbi", "name": "Reserve Bank of India", "type": "regulator",
     "patterns": ["reserve bank of india", "(?-i:\\bRBI\\b)", "भारतीय रिज़र्व बैंक", "रिज़र्व बैंक"]},
    {"id": "sebi", "name": "SEBI", "type": "regulator",
     "patterns": ["(?-i:\\bSEBI\\b)", "securities and exchange board of india", "सेबी"]},
    {"id": "trai", "name": "TRAI", "type": "regulator",
     "patterns": ["(?-i:\\bTRAI\\b)", "telecom regulatory authority", "दूरसंचार नियामक"]},
    {"id": "dpb", "name": "Data Protection Board of India", "type": "regulator",
     "patterns": ["data protection board"]},
    {"id": "npci", "name": "NPCI", "type": "financial",
     "patterns": ["(?-i:\\bNPCI\\b)", "national payments corporation"]},
    {"id": "income_tax", "name": "Income Tax Department", "type": "government",
     "patterns": ["income tax department", "income-tax department", "\\bincome[- ]tax\\b", "आयकर विभाग", "आयकर"]},
    {"id": "customs", "name": "Customs", "type": "government",
     "patterns": ["\\bcustoms\\b", "सीमा शुल्क"]},
    {"id": "government", "name": "Government of India", "type": "government",
     "patterns": ["government of india", "ministry of", "भारत सरकार", "मंत्रालय"]},
    {"id": "police", "name": "Police", "type": "police",
     "patterns": ["\\bpolice\\b", "cyber cell", "\\bcyber ?crime (?:branch|cell|department|police|unit)\\b",
                  "\\b(?:mumbai|delhi|bengaluru|bangalore|kolkata|chennai|hyderabad|pune) cyber ?crime\\b", "पुलिस"]},
    {"id": "court", "name": "Court", "type": "court",
     "patterns": ["\\bcourt\\b", "न्यायालय", "अदालत"]},
    {"id": "named_bank", "name": null, "type": "bank",
