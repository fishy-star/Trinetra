{
  "_comment": "Bodies a message may claim to come from. Listed in priority order: when two match at the same position, the earlier entry wins, so specific bodies come before generic patterns. Patterns are case-insensitive regexes; (?-i:...) makes part case-sensitive. Types: government, court, regulator, police (all government), bank, financial.",
  "agencies": [
    {"id": "supreme_court", "name": "Supreme Court of India", "type": "court",
     "patterns": ["supreme court", "सर्वोच्च न्यायालय", "उच्चतम न्यायालय"]},
    {"id": "high_court", "name": "High Court", "type": "court",
     "patterns": ["high court", "उच्च न्यायालय"]},
    {"id": "cbi", "name": "CBI", "type": "police",
     "patterns": ["(?-i:\\bCBI\\b)", "central bureau of investigation", "केंद्रीय अन्वेषण ब्यूरो", "सीबीआई"]},
    {"id": "ed", "name": "Enforcement Directorate", "type": "government",
