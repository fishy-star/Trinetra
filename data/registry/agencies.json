                  "\\bbank of baroda\\b", "\\bcanara bank\\b", "\\bunion bank\\b", "\\bpunjab national bank\\b",
                  "भारतीय स्टेट बैंक", "एसबीआई"]},
    {"id": "bank", "name": null, "type": "bank",
     "patterns": ["(?-i:\\b[A-Z][a-z]+ Bank\\b)", "(?-i:\\b[A-Z]{2,} BANK\\b)", "[\\u0900-\\u097F]+ बैंक"]},
    {"id": "mutual_fund", "name": null, "type": "financial",
     "patterns": ["(?-i:\\b[A-Z][A-Za-z]+ (?:Mutual Fund|MUTUAL FUND)\\b)", "[\\u0900-\\u097F]+ म्यूचुअल फ़ंड"]}
  ]
}
